{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news.schema.json",
  "title": "News",
  "description": "Announcements, encyclicals and pastoral letters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "news"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "news": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "category",
          "title",
          "summary",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Lowercase id used in links, e.g. st-nicholas-sample."
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date as YYYY-MM-DD."
          },
          "category": {
            "enum": [
              "announcement",
              "encyclical",
              "pastoralLetter"
            ]
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "body": {
            "$ref": "common.schema.json#/$defs/localizedParagraphs"
          },
          "pdf": {
            "type": "string",
            "pattern": "^/",
            "description": "Optional PDF in /public/files."
          },
          "image": {
            "type": "string",
            "pattern": "^/",
            "description": "File in /public, e.g. /images/pd/photo.jpg."
          }
        }
      }
    }
  }
}
