{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "documents.schema.json",
  "title": "Documents library",
  "description": "Forms, policies and guidelines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "audience",
          "file",
          "updated"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Lowercase id used in links, e.g. st-nicholas-sample."
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "category": {
            "enum": [
              "forms",
              "policies",
              "liturgical",
              "finance",
              "assembly"
            ]
          },
          "audience": {
            "enum": [
              "clergy",
              "parishes",
              "everyone"
            ]
          },
          "file": {
            "type": "string",
            "pattern": "^/",
            "description": "File in /public, e.g. /images/pd/photo.jpg."
          },
          "updated": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date as YYYY-MM-DD."
          }
        }
      }
    }
  }
}
