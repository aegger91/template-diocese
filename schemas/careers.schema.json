{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "careers.schema.json",
  "title": "Open assignments",
  "description": "Clergy assignments, staff and volunteer roles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "openings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "intro": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "summary",
          "posted",
          "contactEmail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Lowercase id used in links, e.g. st-nicholas-sample."
          },
          "kind": {
            "enum": [
              "clergyAssignment",
              "staff",
              "volunteer"
            ]
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "parishId": {
            "type": "string"
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "posted": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date as YYYY-MM-DD."
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  }
}
